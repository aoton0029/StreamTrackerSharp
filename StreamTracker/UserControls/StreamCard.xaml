<UserControl x:Class="StreamTracker.UserControls.StreamCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StreamTracker.UserControls"
             mc:Ignorable="d" >
    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="4" CornerRadius="8">
        <StackPanel>
            <Image Source="{Binding ThumbnailUrl}" Width="320" Height="180"/>
            <TextBlock Text="{Binding UserName}" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="{Binding StartedAt}" FontSize="10" Foreground="Gray"/>
        </StackPanel>
    </Border>
</UserControl>
